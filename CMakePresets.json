{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "pico2",
      "displayName": "Pico 2 default",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/pico2",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "PICO_BOARD": "pico2",
        "PICO_AIO_USB_PROFILE": "default"
      }
    },
    {
      "name": "pico2-yubikey5",
      "displayName": "Pico 2 YubiKey compatibility",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/pico2",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "PICO_BOARD": "pico2",
        "PICO_AIO_USB_PROFILE": "yubikey5"
      }
    },
    {
      "name": "rp2350-usb",
      "displayName": "RP2350 USB with WS2812 GPIO22",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/rp2350-usb",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "PICO_BOARD": "pico_aio_rp2350_usb",
        "PICO_AIO_USB_PROFILE": "default"
      }
    },
    {
      "name": "rp2350-usb-yubikey5",
      "displayName": "RP2350 USB YubiKey compatibility",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/rp2350-usb",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "PICO_BOARD": "pico_aio_rp2350_usb",
        "PICO_AIO_USB_PROFILE": "yubikey5"
      }
    },
    {
      "name": "emu",
      "displayName": "Host emulation",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/emu",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ENABLE_EMULATION": "ON"
      }
    },
    {
      "name": "rp2350-usb-debug",
      "displayName": "RP2350 USB debug BOOTSEL",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/rp2350-usb-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "PICO_BOARD": "pico_aio_rp2350_usb",
        "PICO_AIO_USB_PROFILE": "yubikey5",
        "PICO_AIO_DEBUG_BOOTSEL": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "pico2",
      "configurePreset": "pico2"
    },
    {
      "name": "pico2-yubikey5",
      "configurePreset": "pico2-yubikey5"
    },
    {
      "name": "rp2350-usb",
      "configurePreset": "rp2350-usb"
    },
    {
      "name": "rp2350-usb-yubikey5",
      "configurePreset": "rp2350-usb-yubikey5"
    },
    {
      "name": "emu",
      "configurePreset": "emu"
    },
    {
      "name": "rp2350-usb-debug",
      "configurePreset": "rp2350-usb-debug"
    }
  ]
}
